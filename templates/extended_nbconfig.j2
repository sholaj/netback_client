# extended_nbconfig.j2 - Enhanced template with more configuration elements
{% if nbconfig is defined %}
  {% set config = nbconfig %}
{% else %}
  {% set config = test_config %}
{% endif %}

# Server Configuration
{% for server in config.server %}
SERVER = {{ server }}
{% endfor %}

# Media Server Configuration
{% for media_server in config.mediaserver %}
MEDIA_SERVER = {{ media_server }}
{% endfor %}

# Client Configuration
CLIENT_NAME = {{ config.client_name }}

# Connection Settings
{% for key, value in config.client_config.items() %}
{{ key }} = {{ value }}
{% endfor %}

# Policy Configuration
{% for policy in config.policy %}
POLICY {{ policy.name }}
POLICY_TYPE = {{ policy.type }}
SCHEDULE = {{ policy.schedule }}
{% endfor %}

# Path Configuration
{% for path in config.paths %}
{{ path }}
{% endfor %}

